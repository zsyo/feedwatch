# Copy this file to .env (Docker Compose reads it automatically).
# NEVER commit .env with a real key.

# Required when notify.type: email and you are not using -dry-run.
# Create it at https://resend.com/api-keys ; the From domain must be verified.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (flag > env > config.yaml > built-in default)
# FEEDWATCH_CONFIG=config.yaml
# FEEDWATCH_STATE_PATH=/app/data/state.json
# FEEDWATCH_POLL_INTERVAL=30m
# FEEDWATCH_LOG_LEVEL=info
# FEEDWATCH_LOG_FORMAT=json
# FEEDWATCH_DRY_RUN=true

# Windows PowerShell local development:
#   $env:RESEND_API_KEY="re_xxx"
#   .\feedwatch.exe -config config.yaml -once
