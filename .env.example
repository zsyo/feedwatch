# Copy this file to .env (Docker Compose reads it automatically).
# NEVER commit .env with a real key.
#
# Only the variables for channels you actually enable are required.
# In YAML they are referenced as ${NAME}; feedwatch expands them at startup
# and fails fast (with the variable name) if a referenced one is missing.

# ---- Email (Resend) ----
# Required when an email channel is enabled and you are not using -dry-run.
# Create it at https://resend.com/api-keys ; the From domain must be verified.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 企业微信群机器人 ----
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# ---- 飞书自定义机器人 ----
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
FEISHU_WEBHOOK_SECRET=

# ---- 钉钉自定义机器人（安全设置选「加签」时填 secret）----
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx
DINGTALK_WEBHOOK_SECRET=

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=@your_channel

# ---- Slack / Discord / Teams ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx
TEAMS_WEBHOOK_URL=https://prod-xx.westus.logic.azure.com/workflows/xxx

# ---- Bark（iOS）/ ntfy ----
BARK_WEBHOOK_URL=https://api.day.app/your_device_key
NTFY_TOPIC_URL=https://ntfy.sh/your-topic
NTFY_TOKEN=

# ---- 通用自定义 Webhook ----
GENERIC_WEBHOOK_URL=https://your-service.example.com/hook
GENERIC_TOKEN=

# ---- Optional overrides (flag > env > config.yaml > built-in default) ----
# FEEDWATCH_CONFIG=config.yaml
# FEEDWATCH_STATE_PATH=/app/data/state.json
# FEEDWATCH_POLL_INTERVAL=30m
# FEEDWATCH_LOG_LEVEL=info
# FEEDWATCH_LOG_FORMAT=json
# FEEDWATCH_DRY_RUN=true

# ---- Container user: only when /app/data is a BIND MOUNT (e.g. ./data) ----
# The image runs as the unprivileged "app" user. The default named volume is
# fine, but a bind mount keeps the HOST directory owner, so state.json cannot
# be written. Run the container as that owner instead of chmod 777 / chown:
#
#   printf 'FW_UID=%s\nFW_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# IMPORTANT: Compose interpolates ${FW_UID}/${FW_GID} but does NOT execute
# $(...). The values here must be plain numbers, never a literal $(id -u).
# Avoid the names UID/GID: bash/zsh mark UID read-only, so UID=$(id -u) fails.
# Leave both unset for the default named volume (user stays "app:app").
# These are Compose-side variables and are NOT passed into the container.
# FW_UID=1000
# FW_GID=1000

# ---- WebUI 变体（与上面的 base 二选一，不要同时启动两套轮询）----
# 启动：cp config.example.yaml config.yaml
#       docker compose -f docker-compose.webui.yml up -d --build
# 首启随机管理员密码只在容器日志里打印一次：
#       docker logs -f feedwatch-webui
# 宿主端口；WebUI 的 SQLite 数据库固定在 /app/data/feedwatch.db 命名卷中。
WEBUI_HTTP_PORT=8080
# 仅在 HTTPS 反向代理之后设为 true；纯 HTTP 直连设 true 会导致无法登录。
FEEDWATCH_WEBUI_COOKIE_SECURE=false
# 会话有效期，Go duration 格式。
FEEDWATCH_WEBUI_SESSION_TTL=168h
# 本地构建时可覆盖注入的版本号（CI 由 build-arg 传入）。
# VERSION=dev
# WebUI 也读取上面的渠道密钥：种子从 config.yaml 导入渠道后，发送时才在
# 内存中展开 ${ENV_VAR} 占位符，密钥本身不写入数据库。

# Windows PowerShell local development:
#   $env:RESEND_API_KEY="re_xxx"
#   $env:WECOM_WEBHOOK_URL="https://qyapi.weixin.qq.com/..."
#   .\feedwatch.exe -config config.yaml -once
