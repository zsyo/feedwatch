# Local binaries. The slash anchors the rule to the repo root: an unanchored
# "feedwatch" also matches the cmd/feedwatch/ SOURCE directory, which would
# silently keep main.go out of the repository and break Docker builds.
*.exe
*.test
dist/
/feedwatch

# Runtime state (contains the seen-ID baseline)
data/
*.dryrun.json

# Secrets and per-deployment config (verified domain, recipients, feed list).
# Only config.example.yaml is versioned; copy it to config.yaml before running.
.env
config.yaml
config.local.yaml

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# WorkBuddy workspace data (agent memory, not application code)
.workbuddy/

# WebUI: Vite writes index.html / assets / BUILD_ID into embedded/. Only the
# placeholder and the directory keeper are versioned; real assets are rebuilt by
# `make build-webui` locally or by the Docker Node stage.
internal/webui/embedded/*
!internal/webui/embedded/stub.html
!internal/webui/embedded/.gitkeep
web/node_modules/
